+package com.android.settings.lenovo;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.util.Log;
+
+import java.util.Set;
+
+/**
+ * The stock Lenovo settings app opens pages of other Lenovo apps inside
+ * Settings with action com.android.settings.PLACE_HOLDER and the target in
+ * :settings:place_holder_package_name / _class_name. The Lenovo PenService
+ * uses it for its pen settings (e.g. the settings button of the stylus
+ * toolbox). Settings here has no such embedding; open the page directly.
+ */
+public class LenovoPlaceHolderActivity extends Activity {
+    private static final String TAG = "LenovoPlaceHolder";
+
+    private static final String EXTRA_PACKAGE = ":settings:place_holder_package_name";
+    private static final String EXTRA_CLASS = ":settings:place_holder_class_name";
+
+    /** Only pages of these apps are opened. */
+    private static final Set<String> ALLOWED = Set.of("com.lenovo.penservice");
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Intent in = getIntent();
+        String pkg = in.getStringExtra(EXTRA_PACKAGE);
+        String cls = in.getStringExtra(EXTRA_CLASS);
+        // Class names of these apps do not always start with the package name
+        // (com.lenovo.penservice -> com.lenovo.pen.bt.ui.BtSettingsActivity).
+        if (!TextUtils.isEmpty(pkg) && !TextUtils.isEmpty(cls) && ALLOWED.contains(pkg)) {
+            Intent out = new Intent(Intent.ACTION_MAIN)
+                    .setClassName(pkg, cls)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            Bundle extras = in.getExtras();
+            if (extras != null) out.putExtras(extras);
+            try {
+                startActivity(out);
+            } catch (Exception e) {
+                Log.w(TAG, "cannot open " + pkg + "/" + cls, e);
+            }
+        } else {
+            Log.w(TAG, "ignored " + pkg + "/" + cls);
+        }
+        finish();
+    }
+}
