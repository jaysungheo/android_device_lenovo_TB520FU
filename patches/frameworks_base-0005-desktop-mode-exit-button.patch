+package com.android.wm.shell.desktopmode;
+
+import android.app.ActivityTaskManager;
+import android.app.KeyguardManager;
+import android.app.TaskStackListener;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.res.ColorStateList;
+import android.content.res.Configuration;
+import android.content.res.Resources;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.RippleDrawable;
+import android.os.Handler;
+import android.util.Log;
+import android.view.Display;
+import android.view.Gravity;
+import android.view.View;
+import android.view.WindowInsets;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+import java.util.function.BooleanSupplier;
+import java.util.function.Supplier;
+
+/** A tablet-mode exit control above the taskbar, owned by WM Shell. */
+public final class DesktopModeExitButton {
+    private static final String TAG = "DesktopModeExitButton";
+    private static final int WINDOW_TYPE = WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL;
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final BooleanSupplier mDesktopVisible;
+    private final Supplier<String> mLabel;
+    private final Runnable mExit;
+    private final WindowManager mWindowManager;
+    private final KeyguardManager mKeyguard;
+    private View mButton;
+    private final Runnable mUpdate = this::update;
+
+    public DesktopModeExitButton(Context context, Handler handler, BooleanSupplier desktopVisible,
+            Supplier<String> label, Runnable exit) {
+        mContext = context.createWindowContext(WINDOW_TYPE, null);
+        mHandler = handler;
+        mDesktopVisible = desktopVisible;
+        mLabel = label;
+        mExit = exit;
+        mWindowManager = mContext.getSystemService(WindowManager.class);
+        mKeyguard = context.getSystemService(KeyguardManager.class);
+    }
+
+    public void start() {
+        try {
+            ActivityTaskManager.getService().registerTaskStackListener(new TaskStackListener() {
+                @Override
+                public void onTaskStackChanged() { schedule(); }
+
+                @Override
+                public void onTaskFocusChanged(int taskId, boolean focused) { schedule(); }
+            });
+            mKeyguard.addKeyguardLockedStateListener(mHandler::post, locked -> update());
+            IntentFilter filter = new IntentFilter();
+            filter.addAction(Intent.ACTION_SCREEN_OFF);
+            filter.addAction(Intent.ACTION_SCREEN_ON);
+            filter.addAction(Intent.ACTION_USER_PRESENT);
+            filter.addAction(Intent.ACTION_USER_SWITCHED);
+            filter.addAction(Intent.ACTION_CONFIGURATION_CHANGED);
+            filter.addAction(Intent.ACTION_WALLPAPER_CHANGED);
+            filter.addAction(Intent.ACTION_OVERLAY_CHANGED);
+            mContext.registerReceiver(new BroadcastReceiver() {
+                @Override
+                public void onReceive(Context context, Intent intent) {
+                    hide();
+                    schedule();
+                }
+            }, filter, null, mHandler, Context.RECEIVER_NOT_EXPORTED);
+            update();
+        } catch (Exception e) {
+            Log.e(TAG, "Cannot start desktop exit button", e);
+        }
+    }
+
+    private void schedule() {
+        mHandler.removeCallbacks(mUpdate);
+        mHandler.postDelayed(mUpdate, 150);
+    }
+
+    private int dp(int value) {
+        return Math.round(value * mContext.getResources().getDisplayMetrics().density);
+    }
+
+    /** Resolve the same dynamic color resources used by the installed Pixel taskbar. */
+    private Resources taskbarResources() {
+        try {
+            Context launcher = mContext.createPackageContext(
+                    "com.google.android.apps.nexuslauncher", 0);
+            return launcher.createConfigurationContext(
+                    mContext.getResources().getConfiguration()).getResources();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private int taskbarColor(Resources resources, String name, int fallback) {
+        if (resources != null) {
+            int id = resources.getIdentifier(name, "color", "com.google.android.apps.nexuslauncher");
+            if (id != 0) return resources.getColor(id, null);
+        }
+        return mContext.getColor(fallback);
+    }
+
+    private void update() {
+        try {
+            if (mKeyguard.isKeyguardLocked()
+                    || mContext.getDisplay().getState() != Display.STATE_ON
+                    || !mDesktopVisible.getAsBoolean()) {
+                hide();
+                return;
+            }
+            if (mButton != null) return;
+
+            boolean night = (mContext.getResources().getConfiguration().uiMode
+                    & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
+            Resources taskbar = taskbarResources();
+            int backgroundColor = taskbarColor(taskbar, "taskbar_background",
+                    night ? android.R.color.system_neutral1_900 : android.R.color.system_neutral1_50);
+            int foregroundColor = taskbarColor(taskbar,
+                    night ? "taskbar_nav_icon_light_color" : "taskbar_nav_icon_dark_color",
+                    night ? android.R.color.system_neutral1_100 : android.R.color.system_neutral1_900);
+
+            TextView button = new TextView(mContext);
+            button.setText(mLabel.get());
+            button.setContentDescription(mLabel.get());
+            button.setTooltipText(mLabel.get());
+            button.setTextSize(14);
+            button.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
+            button.setTextColor(foregroundColor);
+            button.setGravity(Gravity.CENTER);
+            button.setPadding(dp(18), 0, dp(18), 0);
+            button.setSingleLine(true);
+            button.setElevation(dp(6));
+            Drawable icon = new ExitIcon(foregroundColor);
+            icon.setBounds(0, 0, dp(24), dp(24));
+            button.setCompoundDrawablesRelative(icon, null, null, null);
+            button.setCompoundDrawablePadding(dp(8));
+            int rippleColor = (foregroundColor & 0x00ffffff) | 0x22000000;
+            int outlineColor = (foregroundColor & 0x00ffffff) | 0x1f000000;
+            GradientDrawable mask = new GradientDrawable();
+            mask.setColor(Color.WHITE);
+            mask.setCornerRadius(dp(24));
+            // Translucent taskbar color with a hairline outline.
+            GradientDrawable background = new GradientDrawable();
+            background.setColor((backgroundColor & 0x00ffffff) | 0xcc000000);
+            background.setCornerRadius(dp(24));
+            background.setStroke(Math.max(1, dp(1) / 2), outlineColor);
+            button.setBackground(new RippleDrawable(ColorStateList.valueOf(rippleColor),
+                    background, mask));
+            button.setOnClickListener(view -> {
+                try {
+                    mExit.run();
+                    hide();
+                    mHandler.postDelayed(mUpdate, 700);
+                } catch (Exception e) {
+                    Log.e(TAG, "Cannot exit desktop mode", e);
+                }
+            });
+
+            // Room around the button for its shadow.
+            int shadow = dp(10);
+            FrameLayout container = new FrameLayout(mContext);
+            container.setPadding(shadow, shadow, shadow, shadow);
+            container.setClipToPadding(false);
+            container.addView(button, new FrameLayout.LayoutParams(
+                    FrameLayout.LayoutParams.WRAP_CONTENT, dp(48)));
+
+            WindowManager.LayoutParams params = new WindowManager.LayoutParams(
+                    WindowManager.LayoutParams.WRAP_CONTENT, dp(48) + 2 * shadow, WINDOW_TYPE,
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                            | WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
+                    PixelFormat.TRANSLUCENT);
+            params.gravity = Gravity.BOTTOM | Gravity.LEFT;
+            params.x = dp(24) - shadow;
+            int taskbarHeight = dp(64);
+            if (taskbar != null) {
+                int id = taskbar.getIdentifier("taskbar_size", "dimen",
+                        "com.google.android.apps.nexuslauncher");
+                if (id != 0) taskbarHeight = taskbar.getDimensionPixelSize(id);
+            }
+            // Above the taskbar, like the stock ZUI exit button.
+            params.y = taskbarHeight + dp(12) - shadow;
+            params.setFitInsetsTypes(WindowInsets.Type.displayCutout());
+            params.privateFlags |= WindowManager.LayoutParams.PRIVATE_FLAG_TRUSTED_OVERLAY;
+            params.setTitle(TAG);
+            mWindowManager.addView(container, params);
+            mButton = container;
+        } catch (Exception e) {
+            Log.e(TAG, "Cannot update desktop exit button", e);
+        }
+    }
+
+    private void hide() {
+        if (mButton == null) return;
+        try {
+            mWindowManager.removeView(mButton);
+        } catch (Exception e) {
+            Log.w(TAG, "Cannot remove desktop exit button", e);
+        }
+        mButton = null;
+    }
+
+    /** Tablet outline and outward arrow, following the stock ZUI exit affordance. */
+    private static final class ExitIcon extends Drawable {
+        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path mPath = new Path();
+
+        ExitIcon(int color) {
+            mPaint.setColor(color);
+            mPaint.setStyle(Paint.Style.STROKE);
+            mPaint.setStrokeWidth(1.8f);
+            mPaint.setStrokeCap(Paint.Cap.ROUND);
+            mPaint.setStrokeJoin(Paint.Join.ROUND);
+            mPath.moveTo(16, 7);
+            mPath.lineTo(16, 4);
+            mPath.quadTo(16, 3, 15, 3);
+            mPath.lineTo(5, 3);
+            mPath.quadTo(4, 3, 4, 4);
+            mPath.lineTo(4, 20);
+            mPath.quadTo(4, 21, 5, 21);
+            mPath.lineTo(15, 21);
+            mPath.quadTo(16, 21, 16, 20);
+            mPath.lineTo(16, 17);
+            mPath.moveTo(11, 12);
+            mPath.lineTo(22, 12);
+            mPath.moveTo(18.5f, 8.5f);
+            mPath.lineTo(22, 12);
+            mPath.lineTo(18.5f, 15.5f);
+        }
+
+        @Override public void draw(Canvas canvas) {
+            int save = canvas.save();
+            canvas.translate(getBounds().left, getBounds().top);
+            canvas.scale(getBounds().width() / 24f, getBounds().height() / 24f);
+            canvas.drawPath(mPath, mPaint);
+            canvas.restoreToCount(save);
+        }
+        @Override public void setAlpha(int alpha) { mPaint.setAlpha(alpha); }
+        @Override public void setColorFilter(ColorFilter filter) { mPaint.setColorFilter(filter); }
+        @Override public int getOpacity() { return PixelFormat.TRANSLUCENT; }
+    }
+}
diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/desktopmode/DesktopTasksController.kt b/libs/WindowManager/Shell/src/com/android/wm/shell/desktopmode/DesktopTasksController.kt
index 659479089..cd30f76a6 100644
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/desktopmode/DesktopTasksController.kt
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/desktopmode/DesktopTasksController.kt
@@ -52,6 +52,7 @@ import android.os.IBinder
 import android.os.RemoteException
 import android.os.Trace
 import android.os.UserHandle
+import android.provider.Settings
 import android.os.UserManager
 import android.view.Display.DEFAULT_DISPLAY
 import android.view.Display.INVALID_DISPLAY
@@ -444,6 +445,48 @@ class DesktopTasksController(
             minimizeTask(task, MinimizeReason.KEY_GESTURE)
         }
         desktopScrimController.onInit()
+        if (android.os.Build.DEVICE == "TB520FU") {
+            DesktopModeExitButton(
+                    context,
+                    handler,
+                    {
+                        shellTaskOrganizer.getRunningTasks(DEFAULT_DISPLAY).any {
+                            it.isVisible &&
+                                (it.isFreeform ||
+                                    it.topActivity?.className == DesktopWallpaperActivity::class.java.name)
+                        }
+                    },
+                    { context.getString(R.string.tb520fu_exit_pc_mode) },
+                    { exitDesktopToTablet() },
+                )
+                .start()
+        }
+    }
+
+    /** Keep the foreground app open while leaving desktop mode from the taskbar. */
+    private fun exitDesktopToTablet() {
+        Settings.Global.putInt(
+            context.contentResolver,
+            "tb520fu_keyboard_desktop_mode_exited",
+            1,
+        )
+        // Also leave PC mode entered from the quick settings tile.
+        Settings.Global.putInt(context.contentResolver, "tb520fu_pc_mode", 0)
+        // Keep the overlay non-focusable so the focused desktop task remains identifiable.
+        val task =
+            shellTaskOrganizer.getRunningTasks(DEFAULT_DISPLAY)
+                .filter { it.isVisible && it.isFreeform }
+                .maxByOrNull { if (it.isFocused) Long.MAX_VALUE else it.lastActiveTime }
+        if (task != null) {
+            moveToFullscreen(task.taskId, DesktopModeTransitionSource.TASKBAR)
+        } else {
+            context.startActivityAsUser(
+                Intent(Intent.ACTION_MAIN)
+                    .addCategory(Intent.CATEGORY_HOME)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+                UserHandle.CURRENT,
+            )
+        }
     }
 
     @VisibleForTesting
