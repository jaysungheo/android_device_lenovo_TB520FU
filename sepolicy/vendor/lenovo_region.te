# init.lenovo.region.sh: reads the running dtb, publishes its region
type lenovo_region, domain;
type lenovo_region_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(lenovo_region)

allow lenovo_region vendor_shell_exec:file rx_file_perms;
allow lenovo_region vendor_toolbox_exec:file rx_file_perms;
allow lenovo_region vendor_sysfs_fdt:file r_file_perms;
set_prop(lenovo_region, vendor_lenovo_region_prop)

# The updater (net.pixelos.ota, updater_app) picks the PRC/ROW package by the
# region; its domain is not visible to vendor policy, so allow app domains
# (the value is only "PRC" or "ROW").
get_prop(appdomain, vendor_lenovo_region_prop)
