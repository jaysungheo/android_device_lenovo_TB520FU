<?xml version="1.0" encoding="utf-8"?>
<!-- Display configuration of the built-in panel of the Lenovo Yoga Tab Plus. -->
<displayConfiguration>
    <name>Lenovo TB520FU LCD</name>

    <screenBrightnessMap>
        <point><value>0.000977</value><nits>7.91434</nits></point>
        <point><value>0.011811024</value><nits>8.0</nits></point>
        <point><value>0.04330709</value><nits>30.0</nits></point>
        <point><value>0.10236221</value><nits>70.0</nits></point>
        <point><value>0.1496063</value><nits>100.0</nits></point>
        <point><value>0.18110237</value><nits>120.0</nits></point>
        <point><value>0.22834645</value><nits>150.0</nits></point>
        <point><value>0.27559054</value><nits>180.0</nits></point>
        <point><value>0.31889763</value><nits>210.0</nits></point>
        <point><value>0.41338584</value><nits>270.0</nits></point>
        <point><value>0.51968503</value><nits>340.0</nits></point>
        <point><value>0.6456693</value><nits>420.0</nits></point>
        <point><value>0.7362205</value><nits>480.0</nits></point>
        <point><value>0.8464567</value><nits>550.0</nits></point>
        <point><value>1.0</value><nits>650.0</nits></point>
    </screenBrightnessMap>
    <screenBrightnessDefault>0.2862</screenBrightnessDefault>

    <!-- HDR content raises the backlight above the SDR brightness, up to the
         maximum the panel does in its normal range; SDR content is dimmed to
         keep its brightness. -->
    <hdrBrightnessConfig>
        <brightnessMap>
            <point><first>0</first><second>0.7</second></point>
            <point><first>100</first><second>0.85</second></point>
            <point><first>1000</first><second>1.0</second></point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>500</brightnessIncreaseDebounceMillis>
        <brightnessDecreaseDebounceMillis>3000</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.5</screenBrightnessRampIncrease>
        <screenBrightnessRampDecrease>0.3</screenBrightnessRampDecrease>
        <minimumHdrPercentOfScreenForNbm>0.25</minimumHdrPercentOfScreenForNbm>
        <minimumHdrPercentOfScreenForHbm>0.25</minimumHdrPercentOfScreenForHbm>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <sdrHdrRatioMap>
            <point><first>2.0</first><second>8.0</second></point>
            <point><first>300.0</first><second>3.0</second></point>
            <point><first>650.0</first><second>1.0</second></point>
        </sdrHdrRatioMap>
    </hdrBrightnessConfig>
</displayConfiguration>
