<resources>
    <!-- Stock GalleryMainTheme (targetSdk 34, no navigationBarColor, so the
         framework default black showed as a band at the bottom of the
         Settings two-pane layout). A style overlay replaces the whole entry:
         the stock items are repeated, plus the navigation bar color. -->
    <style name="GalleryMainTheme" parent="@*com.zui.keyboardupdate:style/Theme.AppCompat.Zui">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:layout_height">300.0dp</item>
        <item name="colorPrimary">@color/background_zui</item>
        <item name="android:navigationBarColor">@color/background_zui</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
