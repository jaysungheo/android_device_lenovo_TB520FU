<!-- Map the page background of the stock Lenovo keyboard-update app onto
     the PixelOS Settings surface. Only the plain colour resource is
     overlaid: a style overlay cannot name the app private parent theme
     (Theme.AppCompat.Zui), its 0x7f reference resolves inside the overlay
     and MainActivity then crashes without an AppCompat theme. -->
<resources>
    <color name="background_zui">@android:color/system_surface_container_light</color>
</resources>
