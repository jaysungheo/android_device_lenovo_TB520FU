runtime_resource_overlay {
    name: "KeyboardUpdateResTB520FU",
    product_specific: true,
    // The theme overlay names the non-public parent style of the stock app.
    aaptflags: [
        "-I",
        "vendor/lenovo/TB520FU/proprietary/system_ext/app/ZuiKeyboardUpdate/ZuiKeyboardUpdate.apk",
    ],
}
