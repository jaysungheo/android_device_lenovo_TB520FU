<!-- The pen pages come from the stock Lenovo PenService (ZUI 17.5). Its
     zui.appcompat theme paints them with the static #ff666666/#ff191919 greys
     and its own accent; map the preference text and the switch onto the
     dynamic system palette so the pages match the rest of Settings. Only plain
     colour resources are overlaid (the selectors on top of them keep their
     disabled states); values-night follows with the dark roles. -->
<resources>
    <!-- Preference title -->
    <color name="list_item_text_normal_zui">@android:color/system_neutral1_900</color>
    <color name="list_item_text_disabled_zui">@android:color/system_neutral2_300</color>
    <!-- Preference summary -->
    <color name="list_item_second_line_text_normal_zui">@android:color/system_neutral2_600</color>
    <!-- Category title: PixelOS Settings titles use the primary colour above
         the card groups (BasePreferenceFragmentCompat in lenovo/PenService),
         on the page background. -->
    <color name="preference_category_text_zui">@android:color/system_primary_light</color>
    <color name="preference_category_bg_zui">@android:color/transparent</color>
    <!-- The pen pages use the "X" category layout (preference_category_x):
         its row background points at system_background_zui directly (a
         lighter grey than the page, seen as a strip between the card groups)
         and its title at a fixed grey. -->
    <color name="preference_category_x_space_background">@android:color/transparent</color>
    <color name="preference_category_x_lower_text">@android:color/system_primary_light</color>
    <color name="preference_category_x_upper_text">@android:color/system_on_surface_variant_light</color>
    <!-- Switch (track when on) and its pressed/hovered states -->
    <color name="system_primary_color_on_zui">@android:color/system_accent1_600</color>
    <color name="system_primary_color_on_pressed_zui">@android:color/system_accent1_700</color>
    <color name="system_primary_color_on_hovered_zui">@android:color/system_accent1_700</color>
    <color name="system_primary_color_off_pressed_zui">@android:color/system_neutral2_600</color>
    <color name="system_icon_off_color_zui">@android:color/system_neutral2_300</color>
    <!-- Page and navigation bar background: the PixelOS Settings background
         (settingslib_materialColorSurfaceContainer). -->
    <color name="background_zui">@android:color/system_surface_container_light</color>
    <!-- Dialogs (zui.app.MessageDialog, the list preference dialog): the
         Material 3 dialog colours of PixelOS (surface container high, title
         on surface, text on surface variant, primary text buttons) without
         the ZUI divider above the buttons. The layout stays the ZUI one. -->
    <color name="dialog_background_zui">@android:color/system_surface_container_high_light</color>
    <color name="dialog_background_zui_dark">@android:color/system_surface_container_high_dark</color>
    <color name="dialog_divider_zui">@android:color/transparent</color>
    <color name="dialog_divider_zui_dark">@android:color/transparent</color>
    <color name="dialog_button_text_normal_zui">@android:color/system_primary_light</color>
    <color name="text_title_dialog_zui">@android:color/system_on_surface_light</color>
    <color name="text_title_dialog_zui_dark">@android:color/system_on_surface_dark</color>
    <color name="text_body_dialog_zui">@android:color/system_on_surface_variant_light</color>
    <color name="text_body_dialog_zui_dark">@android:color/system_on_surface_variant_dark</color>
    <color name="dialog_list_item_text_color">@android:color/system_on_surface_light</color>
    <color name="dialog_list_item_text_color_dark">@android:color/system_on_surface_dark</color>
    <!-- The button row has its own background (btn_dialog_zui), white before:
         the same surface as the dialog. -->
    <!-- Button panel under the buttons (message_dialog): it showed white
         through the rounded button corners and the transparent divider. -->
    <color name="button_background_zui">@android:color/system_surface_container_high_light</color>
    <color name="dialog_button_background_normal_zui">@android:color/system_surface_container_high_light</color>
    <color name="dialog_button_background_normal_zui_dark">@android:color/system_surface_container_high_dark</color>

    <!-- Recognition languages page: the lists are cards of the Settings
         surface, with the Settings text color; the download button is the
         tonal pill of the other Settings rows (progress fills it with the
         primary container). The stock page used white cards, a green
         progress and a grey outline. -->
    <color name="panel_bg_color">@android:color/system_surface_light</color>
    <color name="language_downloaded_text_color">@android:color/system_on_surface_light</color>
    <color name="language_not_downloaded_text_color">@android:color/system_on_surface_light</color>
    <color name="language_progress_view_background">@android:color/system_surface_container_highest_light</color>
    <color name="language_progress_paint_background">@color/panel_bg_color</color>
    <color name="language_progress_stroke">@android:color/transparent</color>
    <color name="language_progress_solid">@android:color/system_primary_container_light</color>
    <color name="language_progress_text">@android:color/system_on_surface_variant_light</color>
    <!-- Selected radio and checkbox -->
    <color name="system_choose_icon_color_zui">@android:color/system_primary_light</color>

    <!-- ZUI 18.5 (A17) sets the row text colours in the layouts instead of
         the theme: preference_text_title_zui and preference_text_summary_zui
         select between these (the summary one already ends at
         preference_category_x_upper_text). Same roles as the ZUI 17.5
         resources above. -->
    <color name="listview_x_edit_title_text">@android:color/system_neutral1_900</color>
    <color name="preference_text_title_disabled_zui">@android:color/system_neutral2_300</color>
    <color name="preference_text_summary_disabled_zui">@android:color/system_neutral2_300</color>
    <color name="preference_category_arrow_disabled_zui">@android:color/system_neutral2_300</color>
    <!-- Radio labels (pen tail and squeeze actions) -->
    <color name="text_title_zui">@android:color/system_neutral1_900</color>
    <!-- App shortcut dialog -->
    <color name="zui_text_color_primary">@android:color/system_on_surface_light</color>
    <color name="app_shortcut_color">@android:color/system_on_surface_light</color>
    <color name="app_shortcut_line">@android:color/system_outline_variant_light</color>
    <!-- Guide dialogs: the dialog roles above; "Try now" a filled button,
         "Got it" a tonal one, without the ZUI outline. -->
    <color name="pen_dialog_title_color">@android:color/system_on_surface_light</color>
    <color name="pen_dialog_content_color">@android:color/system_on_surface_variant_light</color>
    <color name="message_dialog_description_text_color">@android:color/system_on_surface_variant_light</color>
    <color name="pen_dialog_try_now_btn_solid_color">@android:color/system_primary_light</color>
    <color name="pen_dialog_try_now_btn_text_color">@android:color/system_on_primary_light</color>
    <color name="pen_dialog_got_it_btn_solid_color">@android:color/system_surface_container_highest_light</color>
    <color name="pen_dialog_got_it_btn_text_color">@android:color/system_on_surface_light</color>
    <color name="pen_dialog_got_it_btn_stroke_color">@android:color/transparent</color>
    <color name="pen_dialog_got_it_btn_press_solid_color">@android:color/system_secondary_container_light</color>
    <color name="pen_dialog_got_it_btn_press_stroke_color">@android:color/transparent</color>
    <!-- Sliders (writing feedback strength, squeeze pressure): the inactive
         track of the Settings sliders; the active part is already the
         system accent. -->
    <color name="seekbar_track_background_zui">@android:color/system_secondary_container_light</color>
    <color name="seekbar_track_background_disable_zui">@android:color/system_secondary_container_light</color>
    <color name="ic_seekbar_minus_plus">@android:color/system_on_surface_variant_light</color>
    <!-- Pen battery row, gesture pages, floating menu edit page -->
    <color name="battery_bt_info_text">@android:color/system_on_surface_variant_light</color>
    <color name="touch_film_float_divider_color">@android:color/system_outline_variant_light</color>
    <color name="touch_two_find_settings_link_color">@android:color/system_primary_light</color>
    <color name="touch_two_find_settings_title_color">@android:color/system_on_surface_variant_light</color>
    <color name="one_vision_summary_text_color">@android:color/system_on_surface_variant_light</color>
    <color name="floating_menu_edit_item_bg_color">@android:color/system_surface_bright_light</color>
    <color name="floating_menu_edit_item_out_line_color">@android:color/system_outline_variant_light</color>
    <color name="floating_menu_edit_tip_color">@android:color/system_on_surface_variant_light</color>
</resources>
