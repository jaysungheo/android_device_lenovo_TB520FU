on early-init
    # Audio techpack modules, in the stock order. The kernel names them
    # *_dlkm instead of stock's audio_*; WLAN (qca_cld3) is built in.
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules q6_pdr_dlkm q6_notifier_dlkm snd_event_dlkm apr_dlkm adsp_loader_dlkm q6_dlkm native_dlkm usf_dlkm pinctrl_lpi_dlkm swr_dlkm platform_dlkm hdmi_dlkm stub_dlkm wcd_core_dlkm wsa881x_dlkm wsa883x_dlkm bolero_cdc_dlkm wsa_macro_dlkm va_macro_dlkm rx_macro_dlkm tx_macro_dlkm cirrus_cs35l41_dlkm cirrus_wm_adsp_dlkm wcd938x_dlkm wcd938x_slave_dlkm wcd937x_dlkm wcd937x_slave_dlkm machine_dlkm
    write /proc/sys/kernel/sched_boost 1

on init
    # SchedTune
    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1

    # Boot time fs tuning
    write /sys/block/sda/queue/iostats 0
    write /sys/block/sda/queue/scheduler cfq
    write /sys/block/sda/queue/iosched/group_idle 0
    write /sys/block/sda/queue/iosched/slice_idle 0
    write /sys/block/sda/queue/nr_requests 256

    #Moving to init as this is needed for qseecomd
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    start vendor.qseecomd
    start keymaster-4-0

    # bring back all cores
    write /sys/devices/system/cpu/cpu0/online 1
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1
    write /sys/devices/system/cpu/cpu4/online 1
    write /sys/devices/system/cpu/cpu5/online 1
    write /sys/devices/system/cpu/cpu6/online 1
    write /sys/devices/system/cpu/cpu7/online 1

    # report max frequency to unity tasks.
    write /proc/sys/kernel/sched_lib_name "UnityMain,libunity.so"
    write /proc/sys/kernel/sched_lib_mask_force 255

on fs
    start hwservicemanager
    mount_all --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist

    mkdir /mnt/vendor/persist/audio 0755 system system
    mkdir /mnt/vendor/persist/camera 0777 root root
    mkdir /mnt/vendor/persist/data 0700 system system
    mkdir /mnt/vendor/persist/subsys 0770 root system

    chmod 0666 /sys/kernel/boot_adsp/ssr

on post-fs
    mkdir /mnt/vendor/persist/fpc 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system

    chmod 0644 /dev/elliptic0
    chmod 0644 /dev/elliptic1

on late-fs
    mount_all --late

on early-boot
    start vendor.sensors

on boot
    # Abov SAR sensor (stock J607F init.target.rc; stock opens these 0666)
    chown system system /sys/class/capsense/enable
    chown system system /sys/bus/i2c/devices/1-0020/sar_calibration
    chmod 0660 /sys/class/capsense/enable
    chmod 0660 /sys/bus/i2c/devices/1-0020/sar_calibration
    chmod 0664 /sys/bus/i2c/devices/1-0020/sar_proxstatus_ch0
    chmod 0664 /sys/bus/i2c/devices/1-0020/sar_proxstatus_ch1
    chmod 0664 /sys/bus/i2c/devices/1-0020/sar_proxstatus_ch2
    chmod 0664 /sys/bus/i2c/devices/1-0020/sar_proxstatus_ch3
    setprop vendor.lenovotb.shipmode.on 0

# Lenovo ship mode and battery protection (stock J607Z init.target.rc)
on property:vendor.lenovotb.shipmode.on=1
    write /sys/module/qpnp_power_on/parameters/ship_mode_en 1

on property:vendor.lenovotb.shipmode.on=0
    write /sys/module/qpnp_power_on/parameters/ship_mode_en 0

on property:sys.battery.enable_charge=1
    write /sys/class/power_supply/battery/charging_enabled 1

on property:sys.battery.enable_charge=0
    write /sys/class/power_supply/battery/charging_enabled 0

on property:sys.battery.enable_battery_supply=1
    write /sys/class/power_supply/battery/input_suspend 1

on property:sys.battery.enable_battery_supply=0
    write /sys/class/power_supply/battery/input_suspend 0

on boot && property:persist.vendor.usb.controller.default=*
    setprop vendor.usb.controller ${persist.vendor.usb.controller.default}

on charger
    start vendor.power_off_alarm

    setprop vendor.setup.power 1

    # keep one LITTLE and one big
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
    write /sys/devices/system/cpu/cpu4/online 0
    write /sys/devices/system/cpu/cpu5/online 0
    write /sys/devices/system/cpu/cpu7/online 0

on property:sys.boot_completed=1
    setprop vendor.setup.power 1

    # Runtime fs tuning
    write /sys/block/sda/queue/nr_requests 128
    write /sys/block/sda/queue/iostats 1

    # Enable ZRAM on boot_complete
    swapon_all /vendor/etc/fstab.zram

#pd-mapper
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

#Peripheral manager
service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy

on property:vendor.setup.power=1
    # IRQ Tuning (IRQ numbers from gauguin; TODO(J607F): check
    # /proc/interrupts on stock for msm_drm and kgsl_3d0_irq)
    # IRQ 212: msm_drm
    # IRQ 58: kgsl_3d0_irq
    write /proc/irq/212/smp_affinity_list 2
    write /proc/irq/58/smp_affinity_list 1
