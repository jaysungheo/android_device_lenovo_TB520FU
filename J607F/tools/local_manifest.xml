<?xml version="1.0" encoding="UTF-8"?>
<!--
     Local manifest for building J607F on top of PixelOS (seventeen).
     Copy to .repo/local_manifests/J607F.xml, then `repo sync`.

     DRAFT: the device and vendor repositories do not exist yet; the vendor
     repository is generated by extract-files.py from the stock dump.

     Kernel: Lenovo's TB-J607F/J607Z source release (4.19.157, "arnoz"),
     rebased by the community on 4.19.325 + CIP with the Android 17
     backports. Branch CipA17 has no KernelSU; CipA17Ksu is the same with it.
     Pin a fork of it once one exists under jaysungheo.
-->
<manifest>
  <remote name="j607f" fetch="https://github.com/jaysungheo" revision="seventeen" />
  <remote name="nzlnice" fetch="https://github.com/nzlnice" />

  <project name="android_device_lenovo_J607F" path="device/lenovo/J607F" remote="j607f" />
  <project name="kernel_lenovo_J607Z" path="kernel/lenovo/J607F" remote="nzlnice" revision="CipA17" />
  <project name="android_vendor_lenovo_J607F" path="vendor/lenovo/J607F" remote="j607f" />


  <!-- The lito HALs (hardware/qcom-caf/sm8250/*, lineage-24.0-caf-sm8250)
       are already in the PixelOS seventeen manifest. -->
</manifest>
