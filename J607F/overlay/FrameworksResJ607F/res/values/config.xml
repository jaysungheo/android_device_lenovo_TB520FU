     DRAFT for TB-J607F. TODO(J607F): auto-brightness curve and backlight
     range from the stock framework-res overlay (vendor/overlay/*.apk), and
     power_profile.xml (res/xml) from it, like TB520FU.
-->
<resources>
    <!-- Ambient light sensor present (assumed). -->
    <bool name="config_automatic_brightness_available">true</bool>

    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.0</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.4</item>

    <!-- Tablet: navigation bar on screen, no notification LED, no telephony. -->
    <bool name="config_showNavigationBar">true</bool>
    <bool name="config_intrusiveNotificationLed">false</bool>
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>

    <!-- 60 Hz LCD. -->
    <integer name="config_defaultRefreshRate">60</integer>
    <integer name="config_defaultPeakRefreshRate">60</integer>

    <!-- No 3.5 mm jack on this device. -->
    <bool name="config_useDevInputEventForAudioJack">false</bool>

    <!-- Wi-Fi and Bluetooth only. -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"bluetooth,7,7,2,-1,true"</item>
    </string-array>
    <string-array translatable="false" name="radioAttributes">
        <item>"1,1"</item>
        <item>"7,1"</item>
    </string-array>
</resources>
